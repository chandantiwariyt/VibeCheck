rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Validation Blueprint for JournalEntry
    function isValidJournalEntry(data) {
      return data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.content is string && data.content.size() <= 10000
        && data.mode is string && (data.mode == 'reflection' || data.mode == 'brainstorm' || data.mode == 'summary' || data.mode == 'conversation')
        && data.summary is string && data.summary.size() <= 2500
        && data.tags is list && data.tags.size() <= 5 && (data.tags.size() == 0 || data.tags[0] is string)
        && (!('id' in data) || (data.id is string && data.id.size() <= 128));
    }

    // Validation Blueprint for JournalMessage
    function isValidJournalMessage(data) {
      return data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.entryId is string && isValidId(data.entryId)
        && data.role is string && (data.role == 'user' || data.role == 'model')
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 10000
        && (!('id' in data) || (data.id is string && data.id.size() <= 128));
    }

    // Root Collection: entries
    match /entries/{entryId} {
      // Secure List Query: Enforces user isolation directly against resource.data
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Secure Get: Owner only with valid ID guard
      allow get: if isSignedIn() && isValidId(entryId) && resource.data.userId == request.auth.uid;

      // Secure Create: Strict schema validation, owner identity, exact keys, and strict server timestamp
      allow create: if isVerified() && isValidId(entryId)
        && isValidJournalEntry(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().keys().hasAll(['userId', 'title', 'content', 'mode', 'summary', 'tags', 'createdAt', 'updatedAt'])
        && (incoming().keys().size() == 8 || (incoming().keys().size() == 9 && 'id' in incoming()));

      // Secure Update: Action-based update, immutability of owner and createdAt, strictly guarded fields
      allow update: if isVerified() && isValidId(entryId)
        && isValidJournalEntry(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'mode', 'summary', 'tags', 'updatedAt']);

      // Secure Delete: Owner only
      allow delete: if isSignedIn() && isValidId(entryId) && existing().userId == request.auth.uid;

      // Subcollection: messages (Multi-turn dialogue turns)
      match /messages/{messageId} {
        // Secure List Query: Owner check without expensive get() lookups
        allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

        // Secure Get: Owner only with valid ID guard
        allow get: if isSignedIn() && isValidId(entryId) && isValidId(messageId) && resource.data.userId == request.auth.uid;

        // Secure Create: Master Gate (Relational Sync) verifies parent entry exists and belongs to current user
        allow create: if isVerified() && isValidId(entryId) && isValidId(messageId)
          && isValidJournalMessage(incoming())
          && incoming().userId == request.auth.uid
          && incoming().entryId == entryId
          && incoming().createdAt == request.time
          && incoming().keys().hasAll(['entryId', 'userId', 'role', 'content', 'createdAt'])
          && (incoming().keys().size() == 5 || (incoming().keys().size() == 6 && 'id' in incoming()))
          && exists(/databases/$(database)/documents/entries/$(entryId))
          && get(/databases/$(database)/documents/entries/$(entryId)).data.userId == request.auth.uid;

        // Messages are immutable once written; updates forbidden
        allow update: if false;

        // Secure Delete: Owner only
        allow delete: if isSignedIn() && isValidId(entryId) && isValidId(messageId) && existing().userId == request.auth.uid;
      }
    }
  }
}
